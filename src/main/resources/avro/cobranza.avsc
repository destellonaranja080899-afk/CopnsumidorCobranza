          { "name": "codigoTerminal", "type": ["null", "string"], "default": null },
          { "name": "numeroContrato", "type": ["null", "string"], "default": null },
          { "name": "idCanalOrigen", "type": "int" },
          { "name": "idSucursalOrigen", "type": "int" },
          { "name": "folioExpressCorresponsales", "type": ["null", "string"], "default": null },
          { "name": "codigoDivisa", "type": ["null", "string"], "default": null },
          { "name": "idPaisPedido", "type": "int" },
          { "name": "idCanalPedido", "type": "int" },
          { "name": "idSucursalPedido", "type": "int" },
          { "name": "numeroPedido", "type": "int" },
          { "name": "numeroTarjeta", "type": ["null", "string"], "default": null },
          { "name": "fechaHoraAbono", "type": "string" },
          { "name": "importe", "type": "string" },
          { "name": "idProcesoPago", "type": ["null", "int"], "default": null },
