              ]
            }
          },
          { "name": "fechaHoraOperacion", "type": "string" },
          { "name": "importeTotal", "type": "double" },
          { "name": "idOperacion", "type": ["null", "long"], "default": null },
          { "name": "idProducto", "type": ["null", "int"], "default": null },
          { "name": "idEstatus", "type": ["null", "int"], "default": null },
          { "name": "usuarioEjecucion", "type": "string" },
          { "name": "idAgente", "type": ["null", "int"], "default": null },
          { "name": "folioAutorizacion", "type": ["null", "string"], "default": null },
